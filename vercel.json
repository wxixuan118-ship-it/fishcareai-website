{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/partners/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/thank-you/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/_next/:path*",
      "destination": "https://species-app.vercel.app/_next/:path*"
    },
    {
      "source": "/species",
      "destination": "https://species-app.vercel.app/species"
    },
    {
      "source": "/species/",
      "destination": "https://species-app.vercel.app/species/"
    },
    {
      "source": "/species/:path*",
      "destination": "https://species-app.vercel.app/species/:path*"
    },
    {
      "source": "/fish-health",
      "destination": "https://species-app.vercel.app/fish-health"
    },
    {
      "source": "/fish-health/",
      "destination": "https://species-app.vercel.app/fish-health/"
    },
    {
      "source": "/fish-health/:path*",
      "destination": "https://species-app.vercel.app/fish-health/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/species/",
      "destination": "/species$is_args$args",
      "statusCode": 301
    },
    {
      "source": "/aquarium-fish-diseases",
      "destination": "/fish-health/",
      "statusCode": 301
    },
    {
      "source": "/aquarium-fish-diseases/",
      "destination": "/fish-health/",
      "statusCode": 301
    },
