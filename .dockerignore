# The Dockerfile ships the build context verbatim:
#     COPY . /usr/share/nginx/html
# and nginx serves it with `try_files $uri $uri/ $uri.html`, so ANY file left in
# the context becomes publicly downloadable. Everything below is build-time or
# internal and has no business being served.
#
# Do NOT add nginx.conf here — the Dockerfile copies it separately to
# /etc/nginx/conf.d/default.conf, then deletes it from the web root. Excluding
# it would break the image build.

# Dependencies (17 MB of jsdom et al., needed only to run scripts/ locally)
node_modules
package.json
package-lock.json

# Build scripts — prerender, OG cards, share/cite injection. Their OUTPUT is
# committed; the scripts themselves never run in the image.
scripts/
indexnow-submit.js
fix-guide-backgrounds.py
.og-tmp

# Content pipeline and internal tooling
data-pipeline/
docs/
admin/

# Internal strategy and working notes — these were reachable at
# /SEO-content-eeat-link-plan.md and similar until now.
*.md
*.csv
*.xlsx
backlink-output/

# VCS, CI and editor state
.git
.gitignore
.github/
.claude/
.vscode/
.idea/

# Secrets and local env
.env
.env.*

# Stale Vercel deployment config (this site is served by nginx on anysites)
.vercel
vercel.json

# Container definition itself
Dockerfile
.dockerignore

# OS noise
.DS_Store
**/.DS_Store
start-local.command

# NOTE deliberately kept and served:
#   robots.txt, ads.txt, sitemap.xml, sitemaps/, favicon.svg
#   BingSiteAuth.xml, yandex_*.html, indexnow-*.txt   (site verification)
#   __forms.html                                       (form submission target)
#   api/contact.js                                     (referenced by contact-form.js)
